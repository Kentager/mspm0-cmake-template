GPIO2.associatedPins[3].$name        = "RIGHT_IN2";
GPIO2.associatedPins[3].assignedPort = "PORTA";
GPIO2.associatedPins[3].assignedPin  = "8";

GPIO3.$name                         = "ENC";
GPIO3.associatedPins.create(4);
GPIO3.associatedPins[0].$name       = "LEFT_ENA";
GPIO3.associatedPins[0].direction   = "INPUT";
GPIO3.associatedPins[0].interruptEn = true;
GPIO3.associatedPins[0].polarity    = "RISE_FALL";
GPIO3.associatedPins[0].pin.$assign = "j17_expansion.1";
GPIO3.associatedPins[1].$name       = "LEFT_ENB";
GPIO3.associatedPins[1].direction   = "INPUT";
GPIO3.associatedPins[1].interruptEn = true;
GPIO3.associatedPins[1].polarity    = "RISE_FALL";
GPIO3.associatedPins[1].pin.$assign = "j17_expansion.6";
GPIO3.associatedPins[2].$name       = "RIGHT_ENA";
GPIO3.associatedPins[2].direction   = "INPUT";
GPIO3.associatedPins[2].interruptEn = true;
GPIO3.associatedPins[2].polarity    = "RISE_FALL";
GPIO3.associatedPins[2].pin.$assign = "boosterpack.13";
GPIO3.associatedPins[3].$name       = "RIGHT_ENB";
GPIO3.associatedPins[3].direction   = "INPUT";
GPIO3.associatedPins[3].interruptEn = true;
GPIO3.associatedPins[3].polarity    = "RISE_FALL";
GPIO3.associatedPins[3].pin.$assign = "boosterpack.14";

GPIO4.$name                               = "KEY";
GPIO4.associatedPins.create(4);
GPIO4.associatedPins[0].direction         = "INPUT";
GPIO4.associatedPins[0].interruptEn       = true;
GPIO4.associatedPins[0].interruptPriority = "2";
GPIO4.associatedPins[0].polarity          = "FALL";
GPIO4.associatedPins[0].internalResistor  = "PULL_UP";
GPIO4.associatedPins[0].$name             = "KEY_0";
GPIO4.associatedPins[0].assignedPort      = "PORTA";
